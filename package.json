{
  "name": "poe1-craft-advisor",
  "version": "0.1.0",
  "description": "What-do-I-do-next crafting advisor for Path of Exile 1 (3.29 Allflame). Static site, all maths in the browser.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build-data": "tsx scripts/build-data.ts",
    "snapshot-prices": "tsx scripts/snapshot-prices.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
